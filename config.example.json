{
  "config_schema_version": 4,
  "h3_binary": "runtime/h3.c/h3",
  "model_root": "runtime/models/MiniMax-H3",
  "default_task": "Ref2VA",
  "output_subdir": "h3-jobs",
  "vpipe_binary": "runtime/bin/vpipe",
  "vpipe_work_dir": "runtime/vpipe-work",
  "vpipe_model": "local/MiniMax-H3-FL2VA-8bit",
  "vpipe_lora": "larryvrh/MiniMax-H3-Turbo-Lora-v4-600-ema",
  "vpipe_lora_768p": "lightx2v/Minimax-h3-Turbo-4step-768p",
  "vpipe_video_bitrate": 10000000,
  "vpipe_engine_generation": "vpipe-v0.1.37",
  "vpipe_low_memory_cap_mb": 12288,
  "vpipe_low_wired_pool_mb": 8192,
  "vpipe_worker_enabled": true,
  "vpipe_worker_heartbeat_timeout_seconds": 15,
  "vpipe_worker_cooldown_seconds": 90,
  "vpipe_worker_memory_poll_seconds": 5,
  "vpipe_worker_memory_stable_samples": 3,
  "vpipe_worker_min_memory_free_percent": 20,
